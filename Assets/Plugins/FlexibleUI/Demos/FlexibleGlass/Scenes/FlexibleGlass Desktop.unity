  m_Layer: 5
  m_Name: 'Click a Dock icon to open or return to an app.

    Right-click its icon
    to close a window or quit.


    A dot means the app is still running, even when
    its window is closed or minimized.


    Drag windows freely. Double-click a
    title bar to fill; the green button enters full screen.


    Enable Dock auto-hide
    in Settings, then move the pointer to the bottom edge to reveal it.'
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
