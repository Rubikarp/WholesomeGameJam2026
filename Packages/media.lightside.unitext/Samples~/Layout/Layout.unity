  m_Name: 
  m_EditorClassIdentifier: LSCore.UIModule::UniText
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 1, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  text: "\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AC \xB7 \u041A\u0438\u0440\u0438\u043B\u043B\u0438\u0446\u0430
    \xB7 \u0540\u0561\u0575\u0565\u0580\u0565\u0576 \xB7 \u10E5\u10D0\u10E0\u10D7\u10E3\u10DA\u10D8
    \xB7 \u13E3\u13B3\u13A9 \xB7 \u16B1\u16A2\u16BE\u16C1\u16B1 \xB7 \u1691\u168C\u1690\u16D7
    \xB7 \u2C03\u2C3E\u2C30\u2C33\u2C41\u2C3E\u2C3B\u2C4C\u2C30 \xB7 \u2D5C\u2D49\u2D3C\u2D49\u2D4F\u2D30\u2D56
    \xB7 \uA559\uA524 \xB7 \u1403\u14C4\u1483\u144E\u1450\u1466\n\u0939\u093F\u0928\u094D\u0926\u0940
    \xB7 \u09AC\u09BE\u0982\u09B2\u09BE \xB7 \u0A2A\u0A70\u0A1C\u0A3E\u0A2C\u0A40
    \xB7 \u0A97\u0AC1\u0A9C\u0AB0\u0ABE\u0AA4\u0AC0 \xB7 \u0B13\u0B21\u0B3C\u0B3F\u0B06
    \xB7 \u0BA4\u0BAE\u0BBF\u0BB4\u0BCD \xB7 \u0C24\u0C46\u0C32\u0C41\u0C17\u0C41
    \xB7 \u0C95\u0CA8\u0CCD\u0CA8\u0CA1 \xB7 \u0D2E\u0D32\u0D2F\u0D3E\u0D33\u0D02
    \xB7 \u0DC3\u0DD2\u0D82\u0DC4\u0DBD \xB7 \u0F56\u0F7C\u0F51\u0F0B\u0F61\u0F72\u0F42
    \xB7 \u12A0\u121B\u122D\u129B\n\u1781\u17D2\u1798\u17C2\u179A \xB7 \u0EA5\u0EB2\u0EA7
    \xB7 \u1019\u103C\u1014\u103A\u1019\u102C \xB7 \u0E44\u0E17\u0E22\u0E44\u0E21\u0E48\u0E21\u0E35\u0E0A\u0E48\u0E2D\u0E07\u0E27\u0E48\u0E32\u0E07\u0E23\u0E30\u0E2B\u0E27\u0E48\u0E32\u0E07\u0E04\u0E33
    \u2014 still wraps on real word boundaries \U0001F92F\n\u4E2D\u6587 \u7B80\u4F53
    \xB7 \u7E41\u9AD4\u5B57 \xB7 \u65E5\u672C\u8A9E \u3072\u3089\u304C\u306A \u30AB\u30BF\u30AB\u30CA
    \u6F22\u5B57 \xB7 \uD55C\uAD6D\uC5B4 \uD55C\uAE00 \xB7 Ti\u1EBFng Vi\u1EC7t \u1EBF
    \u1ED9 \u1EEF \u1EE1\nBeyond the basic plane \U0001F9ED \U00010414\U0001042F\U00010445\U00010428\U00010449\U0001042F\U0001043B
    \xB7 \U00010330\U00010332 \xB7 \U00010000\U00010001 \xB7 \U0001202D\U00012097\U000121A0
    \xB7 \U00013080\U000131A3\U0001307F \xB7 \U0001D11E\U0001D122\n\u2211 \u222B
    \u2207 \u2135 \u221E \u2297 \u21CC \u21BB \xB7 \u265E \u265C \xB7 \u2813\u2811\u2807\u2807\u2815
    \xB7 \u2609 \u263E \u2644 \xB7 \u20AC120 \xA53,400 \u20B9899 \u20BF0.05 \u20B4
    \u20B8"
