  m_Name: 
  m_EditorClassIdentifier: LSCore.UIModule::UniText
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 1, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  text: "Hey! \U0001F389 Just got back from vacation.\n\n\u0632\u0631\u062A Paris
    \u0648 London \u062E\u0644\u0627\u0644 5 \u0623\u064A\u0627\u0645 (\u0631\u062D\u0644\u0629
    \u0631\u0627\u0626\u0639\u0629!) \U0001F30D\n\u0627\u062A\u0635\u0644 \u0628\u064A
    \u0639\u0644\u0649 +972-50-123-4567 \u0627\u0644\u0633\u0627\u0639\u0629 8 PM
    \U0001F4DE\n\u0642\u0627\u0644 Tom: \"Hello world\" \u0648\u0636\u062D\u0643
    \u0643\u062B\u064A\u0631\u0627\u064B \U0001F604\n\n\u0926\u0947\u0916\u0940 \"\u0939\u093F\u0928\u094D\u0926\u0940
    \u0938\u093F\u0928\u0947\u092E\u093E\" festival \u2014 incredible! \U0001F3AC\n\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E44\u0E17\u0E22\u0E2D\u0E23\u0E48\u0E2D\u0E22\u0E21\u0E32\u0E01!
    \u0E23\u0E32\u0E04\u0E32 \u0E3F250 per meal \U0001F35C\nMy family \U0001F468\u200D\U0001F469\u200D\U0001F467\u200D\U0001F466
    loved it. Pizza after? \U0001F355"
  font: {fileID: 0}
  fontStack: {fileID: 0}
  fontSize: 32
  wordWrap: 1
  padding: {x: 0, y: 0, z: 0, w: 0}
  horizontalAlignment: 0
  verticalAlignment: 0
