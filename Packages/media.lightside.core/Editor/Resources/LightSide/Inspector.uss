.lightside-inspector-styles--registered {
    --lightside-accent: rgb(120, 175, 130);
    --lightside-accent-hover: rgb(139, 194, 149);
    --lightside-accent-soft: rgba(120, 175, 130, 0.14);
    --lightside-accent-border: rgba(120, 175, 130, 0.55);
    --lightside-control-idle-border: rgba(120, 175, 130, 0);
    --lightside-selection-text: rgb(40, 40, 40);
    --lightside-text-selection: rgba(120, 175, 130, 0.42);
    --lightside-prefab-override: rgb(55, 145, 255);
    --lightside-control-height: 24px;
    --lightside-collection-row-height: 28px;
    --lightside-control-radius: 6px;
    --lightside-surface-radius: 8px;
    --lightside-gap-compact: 4px;
    --lightside-gap: 6px;
    --lightside-stack-gap-compact: 2px;
    --lightside-stack-gap: 3px;
    --lightside-form-label-gap: 8px;
    --lightside-section-gap: 8px;
    --lightside-section-stack-gap: 4px;
    --lightside-inline-value-width: 112px;
    --lightside-inline-value-space: 118px;
    --unity-cursor-color: var(--lightside-accent);
    --unity-selection-color: var(--lightside-text-selection);
    --unity-colors-label-text-focus: var(--lightside-accent);
    --unity-property-field-label-width-ratio: 0.4;
    --unity-property-field-label-extra-padding: 0;
    --unity-property-field-label-base-min-width: 0;
    --unity-base-field-extra-context-width: 0;
}

.lightside-inspector--dark.lightside-inspector-styles--registered,
.lightside-inspector--dark .lightside-inspector-styles--registered {
    --lightside-control-background: rgb(48, 48, 48);
    --lightside-control-background-hover: rgb(57, 57, 57);
    --lightside-control-border: rgb(34, 34, 34);
    --lightside-control-text: rgb(220, 222, 225);
    --lightside-list-header-background: rgb(44, 44, 44);
    --lightside-muted-text: rgba(220, 222, 225, 0.46);
    --lightside-popup-background: rgb(56, 56, 56);
    --lightside-tooltip-background: rgb(46, 47, 49);
    --lightside-tooltip-border: rgba(139, 194, 149, 0.52);
    --lightside-hierarchy-guide: rgba(190, 190, 190, 0.18);
}

.lightside-inspector--light.lightside-inspector-styles--registered,
.lightside-inspector--light .lightside-inspector-styles--registered {
    --lightside-accent: rgb(57, 87, 63);
    --lightside-accent-hover: rgb(48, 74, 53);
    --lightside-accent-soft: rgba(57, 87, 63, 0.14);
    --lightside-accent-border: rgba(57, 87, 63, 0.55);
    --lightside-control-idle-border: rgba(57, 87, 63, 0);
    --lightside-selection-text: rgb(244, 245, 246);
    --lightside-text-selection: rgba(57, 87, 63, 0.30);
    --lightside-prefab-override: rgb(27, 80, 145);
    --lightside-control-background: rgb(224, 224, 224);
    --lightside-control-background-hover: rgb(235, 235, 235);
    --lightside-control-border: rgb(160, 160, 160);
    --lightside-control-text: rgb(42, 44, 48);
    --lightside-list-header-background: var(--lightside-control-background);
    --lightside-muted-text: rgba(42, 44, 48, 0.52);
    --lightside-popup-background: rgb(238, 238, 238);
    --lightside-tooltip-background: rgb(253, 253, 253);
    --lightside-tooltip-border: rgba(57, 87, 63, 0.52);
    --lightside-hierarchy-guide: rgba(50, 50, 50, 0.34);
}

.lightside-tooltip,
.lightside-popup {
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    color: var(--lightside-control-text);
}

.lightside-tooltip {
    position: absolute;
    display: none;
    min-width: 80px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: var(--lightside-tooltip-background);
    border-radius: var(--lightside-control-radius);
    border-left-color: var(--lightside-tooltip-border);
    border-right-color: var(--lightside-tooltip-border);
    border-top-color: var(--lightside-tooltip-border);
    border-bottom-color: var(--lightside-tooltip-border);
}

.lightside-tooltip__title,
.lightside-tooltip__description {
    min-width: 0;
    margin: 0;
    padding: 0;
    white-space: normal;
    color: var(--lightside-control-text);
}

.lightside-tooltip__title {
    font-size: 11px;
    -unity-font-style: bold;
}

.lightside-tooltip__description {
    margin-top: 6px;
    font-size: 12px;
    opacity: 0.72;
}

.lightside-inspector-styles--registered .unity-button {
    min-width: 0;
    min-height: var(--lightside-control-height);
    margin: 0;
    padding-left: 9px;
    padding-right: 9px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--lightside-control-idle-border);
    border-right-color: var(--lightside-control-idle-border);
    border-top-color: var(--lightside-control-idle-border);
    border-bottom-color: var(--lightside-control-idle-border);
    border-top-left-radius: var(--lightside-control-radius);
    border-top-right-radius: var(--lightside-control-radius);
    border-bottom-left-radius: var(--lightside-control-radius);
    border-bottom-right-radius: var(--lightside-control-radius);
    background-color: var(--lightside-control-background);
    color: var(--lightside-control-text);
    -unity-text-align: middle-center;
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, opacity;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
    cursor: link;
}

.lightside-inspector-styles--registered .unity-button:hover:enabled {
    background-color: var(--lightside-control-background-hover);
    border-left-color: var(--lightside-accent);
    border-right-color: var(--lightside-accent);
    border-top-color: var(--lightside-accent);
    border-bottom-color: var(--lightside-accent);
}

.lightside-inspector-styles--registered .unity-button:active:enabled {
    background-color: var(--lightside-accent);
    border-left-color: var(--lightside-accent);
    border-right-color: var(--lightside-accent);
    border-top-color: var(--lightside-accent);
    border-bottom-color: var(--lightside-accent);
    color: var(--lightside-selection-text);
}

.lightside-inspector-styles--registered .unity-button:disabled {
    opacity: 0.48;
}

.lightside-inspector-styles--registered .lightside-button--accent {
    color: var(--lightside-accent);
}

.lightside-inspector-styles--registered .lightside-transport-button {
    width: 24px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
