.lightside-checkmark {
    position: relative;
    width: 12px;
    min-width: 12px;
    height: 12px;
    min-height: 12px;
    flex-shrink: 0;
}

.lightside-checkmark__short,
.lightside-checkmark__long {
    position: absolute;
    height: 2px;
    background-color: var(--lightside-accent);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
    transform-origin: center;
}

.lightside-checkmark__short {
    left: 1px;
    top: 6px;
    width: 5px;
    rotate: 45deg;
}

.lightside-checkmark__long {
    left: 3px;
    top: 5px;
    width: 8px;
